@echo off
REM Install the McStas 1D Monitor Plotter into a conda environment (Windows).
REM Run from the "Miniforge Prompt" (or any prompt where 'conda' works):
REM     install.bat                 creates/updates env "mcstas-plotter"
REM     install.bat my-env-name     use a different environment name
setlocal

set "ENV_NAME=mcstas-plotter"
if not "%~1"=="" set "ENV_NAME=%~1"
set "HERE=%~dp0"

where conda >nul 2>nul
if errorlevel 1 goto :noconda

echo ^>^>^> Setting up environment "%ENV_NAME%"
call conda run -n "%ENV_NAME%" python -c "pass" >nul 2>nul
if errorlevel 1 goto :create
echo ^>^>^> Environment exists - updating
call conda env update -n "%ENV_NAME%" -f "%HERE%environment.yml" --prune
if errorlevel 1 goto :failed
goto :configured

:create
echo ^>^>^> Creating environment
call conda env create -n "%ENV_NAME%" -f "%HERE%environment.yml"
if errorlevel 1 goto :failed

:configured
set "PYEXE="
for /f "usebackq tokens=1,* delims==" %%a in (`conda run -n "%ENV_NAME%" python -c "import sys; print('PYEXE=' + sys.executable)"`) do if "%%a"=="PYEXE" set "PYEXE=%%b"
if not defined PYEXE goto :failed
echo ^>^>^> Environment python: %PYEXE%

echo ^>^>^> Checking packages
"%PYEXE%" -c "import numpy, matplotlib, PySide6; print('numpy', numpy.__version__, '| matplotlib', matplotlib.__version__, '| PySide6', PySide6.__version__)"
if errorlevel 1 goto :failed

REM Launcher (double-clickable)
> "%HERE%run_plotter.bat" echo @echo off
>> "%HERE%run_plotter.bat" echo REM Launch the McStas 1D Monitor Plotter (generated by install.bat)
>> "%HERE%run_plotter.bat" echo "%PYEXE%" "%HERE%mcstas_plotter.py" %%*

if not exist "%HERE%example_data" "%PYEXE%" "%HERE%make_example_data.py" "%HERE%example_data"

echo.
echo Installation complete.
echo Start the plotter by double-clicking run_plotter.bat, or:
echo     "%HERE%run_plotter.bat" [data_folder]
echo or:
echo     conda activate %ENV_NAME% ^&^& python "%HERE%mcstas_plotter.py" [data_folder]
goto :eof

:noconda
echo ERROR: 'conda' was not found.
echo Install Miniforge from https://conda-forge.org/download/ and run this
echo script from the "Miniforge Prompt" in the Start menu.
exit /b 1

:failed
echo ERROR: installation failed - see the messages above.
exit /b 1
